-- check nulls and duplicates in primary key
Select * from silver.[crm_sales_details]
where sls_ord_num != trim(sls_ord_num)

-- CHECK INVALID DATES 
SELECT NULLIF(sls_order_dt , 0 ) as sls_order_dt
from [bronze].[crm_sales_details]
where sls_order_dt <=0 
OR LEN (sls_order_dt) < 8 
OR sls_order_dt > 20500101 
OR sls_order_dt < 20000101

-- Check invalid date orders 
SELECT *
FROM silver.[crm_sales_details]
WHERE sls_order_dt > sls_ship_date OR sls_order_dt > sls_due_dt
--result 0

-- Check data consistency : between sales , quantity and price 
SELECT sls_sales old_sls_sales ,sls_quantity old_sls_quantity ,sls_price old_sls_price 
FROM silver.[crm_sales_details]
WHERE sls_sales != sls_quantity * sls_price
OR sls_sales <=0 OR sls_quantity <=0 OR sls_price <=0
OR sls_sales IS NULL OR sls_quantity IS NULL OR sls_price IS NULL
ORDER BY sls_sales ,sls_quantity ,sls_price
